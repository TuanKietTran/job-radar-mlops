{
  "title": "Service overview",
  "uid": "job-radar-overview",
  "tags": ["job-radar"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "requests", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "title": "Errors per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(http_errors_total[5m]))", "legendFormat": "errors", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "title": "Latency p95 by path",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "title": "Total requests",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(http_requests_total)", "refId": "A"}
      ]
    }
  ]
}
